{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "OptiGest Cloud Offline",
	"version": "0.1.0",
	"identifier": "com.eosmedtech.optigest.offline",
	"build": {
		"frontendDist": "./ui"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "EosMedTech - OptiGest Cloud Offline",
				"width": 960,
				"height": 680,
				"minWidth": 720,
				"minHeight": 520,
				"center": true
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
		}
	},
	"bundle": {
		"active": false,
		"icon": [
			"icons/icon.png"
		]
	}
}
