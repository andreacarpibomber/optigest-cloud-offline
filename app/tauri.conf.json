{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "OptiGest Cloud Offline",
	"version": "0.2.0",
	"identifier": "com.eosmedtech.optigest.offline",
	"build": {
		"frontendDist": "./ui"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "EosMedTech - OptiGest Cloud Offline",
				"width": 960,
				"height": 680,
				"minWidth": 720,
				"minHeight": 520,
				"center": true,
				"visible": false
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg", "nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	}
}